POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=4
DATABASE_POOL_TIMEOUT_SECONDS=10
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
MODEL_API_KEY=replace_with_server_side_secret
MODEL_TIMEOUT_SECONDS=60
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=replace_with_server_side_secret
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024
# dashscope rerank 走 compatible-api，与 chat/embedding 的 compatible-mode 不同
RERANKER_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANKER_API_KEY=replace_with_server_side_secret
RERANKER_MODEL=qwen3-rerank
RERANKER_MIN_SCORE=0.0
RETRIEVAL_STRATEGY=hybrid_rrf_reranker
PUBLIC_DEMO_MODE=true
PUBLIC_DEMO_MAX_ROWS=20
DEMO_USER_ID=demo-employee
DEMO_ROLE=employee
DEMO_DEPARTMENTS=hr,finance,admin
# 演示登录：强制登录页选身份。密码 hash 已内嵌在 config.py 演示账号默认值里，无需覆盖。
# 三个演示账号：knowledge-admin-demo / department-admin-demo / employee-demo
AUTH_SESSION_SECRET=replace_with_a_long_random_string_at_least_32_chars
INTERNAL_SERVICE_TOKEN=replace-with-a-separate-random-service-token
RETAIL_AGENT_URL=http://host.docker.internal
RETAIL_AGENT_TOKEN=replace-with-the-same-random-service-token
RETAIL_AGENT_TIMEOUT_SECONDS=90
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false
HTTP_PORT=8010
SITE_ADDRESS=:80
ALLOWED_ORIGINS=http://106.52.176.63:8010
